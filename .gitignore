# ============================================
# GIT & VERSION CONTROL
# ============================================

# Git files (but keep .github!)
!.github/
!.gitattributes

# ============================================
# PROJECT-SPECIFIC OVERRIDES
# ============================================

# KEEP these important files (don't ignore)
!.htaccess
!composer.json
!package.json
!tsconfig.json
!php.ini.example

# IGNORE XAMPP specific
/htdocs/
/xampp/

# IGNORE PHPMyAdmin
pma_*
config.inc.php.local

