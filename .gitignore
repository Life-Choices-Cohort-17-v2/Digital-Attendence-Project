# ============================================
# BACKEND (TypeScript/Node.js)
# ============================================

# Dependencies
backend/node_modules/
backend/package-lock.json
backend/yarn.lock
backend/.pnpm-store/

# Build outputs
backend/dist/
backend/build/
backend/out/
backend/.next/

# TypeScript
backend/*.tsbuildinfo
backend/.tscache/

# Environment
backend/.env
backend/.env.local
backend/.env.*.local
backend/.env.production
backend/.env.development

# ============================================
# PHP FRONTEND (No nested .gitignore)
# ============================================

# Composer dependencies (if you add later)
phpfrontend/vendor/
phpfrontend/composer.lock
phpfrontend/composer.phar

# PHP error logs
phpfrontend/*.log
phpfrontend/error_log
phpfrontend/php_errors.log
phpfrontend/*.error.log

# PHP session files
phpfrontend/sessions/
phpfrontend/session/
phpfrontend/tmp/
phpfrontend/temp/

# PHP cache
phpfrontend/.phpunit.result.cache
phpfrontend/.phpunit.cache
phpfrontend/cache/

# PHP environment
phpfrontend/.env
phpfrontend/.env.local
phpfrontend/.env.*.local

